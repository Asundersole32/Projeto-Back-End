# ============================================================================
# DJANGO — núcleo
# ============================================================================

SECRET_KEY=django-insecure-w&psgt&t6su+s9q6a^2e07m-ow99_fp6s@@lat#w(e(srs57q#
DEBUG=True
ALLOWED_HOSTS=localhost, 127.0.0.1, 0.0.0.0, 10.90.100.27

# 'development' | 'staging' | 'production'
# Usado pelo bloco R do settings.py para endurecer cookies/HSTS/SSL em prod.
DJANGO_ENV=development

# ============================================================================
# BANCO DE DADOS — MySQL
# ============================================================================

DB_NAME=banco_testes
DB_USER=mysql
DB_PASSWORD=admin123
DB_HOST=db
DB_PORT=3306

# Tempo (segundos) que uma conexão pode ser reaproveitada antes de fechar.
# 0 = abre/fecha por request (mais lento). 60 é um bom default.
DB_CONN_MAX_AGE=60

# Usado apenas por ferramentas externas (Alembic, DBeaver, scripts ad-hoc).
DATABASE_URL=mysql://root:admin123@db:3306/api
DB_PASSWORD_ROOT=admin123

# ============================================================================
# REDIS / CELERY
# ============================================================================

CELERY_BROKER=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Host/porta usados pelo settings.py para montar defaults de cache.
# Ajuste se seus containers não se chamarem "redis".
REDIS_HOST=redis
REDIS_PORT=6379

# Cache geral (Django) — você já usava /1
CACHE_URL=redis://redis:6379/1

# Cache dedicado para idempotência de webhooks — DB separado para não ser
# apagado por um cache.clear() geral. Se seu Redis não expõe múltiplos DBs,
# troque para /1 (a chave já tem prefixo próprio e não colide).
CACHE_WEBHOOK_URL=redis://redis:6379/2

# ============================================================================
# INTEGRAÇÃO — CRIPTOGRAFIA (OBRIGATÓRIA)
# ============================================================================
# Chave Fernet que cifra credenciais no banco (SistemaExterno.credenciais_cifradas
# e webhook_hmac_*_cifrado).
#
# Gere UMA VEZ com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ⚠️ Se perdê-la, TODAS as credenciais cadastradas tornam-se irrecuperáveis.
# Guarde no cofre (Vault, 1Password, AWS Secrets Manager). Não versione.
INTEGRACAO_SECRET_KEY=YAvGzPSdwa03K8SbjyxzxHOLmYs0ofLZ4RwPyFCDb7A=

# ============================================================================
# INTEGRAÇÃO — RETRY EXPONENCIAL (task Celery genérica)
# ============================================================================
# A task executar_integracao_async retenta falhas transientes (timeout, 5xx,
# 429) com backoff exponencial + jitter. Erros definitivos (400, 401, 422)
# vão direto para a DLQ sem retry.

INTEGRACAO_RETRY_MAX_TENTATIVAS=5
INTEGRACAO_RETRY_BACKOFF_BASE=2
INTEGRACAO_RETRY_BACKOFF_MAX=600
INTEGRACAO_RETRY_JITTER_MAX=2

# ============================================================================
# INTEGRAÇÃO — CIRCUIT BREAKER (por SistemaExterno)
# ============================================================================
# Após N falhas consecutivas, o sistema é bloqueado por X minutos.
# Zera ao primeiro sucesso. Protege ERPs instáveis de serem martelados.

INTEGRACAO_CIRCUIT_LIMITE_FALHAS=5
INTEGRACAO_CIRCUIT_TEMPO_BLOQUEIO_MINUTOS=5

# ============================================================================
# INTEGRAÇÃO — HTTP CLIENT (defaults globais)
# ============================================================================
# Valores iniciais para novos SistemaExterno. Podem ser sobrescritos por
# sistema direto no admin (timeout_segundos, verify_ssl).

INTEGRACAO_HTTP_DEFAULT_TIMEOUT=30
INTEGRACAO_HTTP_DEFAULT_VERIFY_SSL=True
INTEGRACAO_HTTP_RETRY_TOTAL=3
INTEGRACAO_HTTP_RETRY_BACKOFF=0.5
INTEGRACAO_HTTP_USER_AGENT=IntegracaoUniversal/1.0

# ============================================================================
# INTEGRAÇÃO — WEBHOOKS
# ============================================================================
# TTL do delivery_id na chave de idempotência (padrão: 7 dias).
WEBHOOK_IDEMPOTENCIA_TTL_SEGUNDOS=604800

# Só use True em dev, para testar com curl sem montar HMAC.
# O bloco R do settings.py IMPEDE True em produção.
WEBHOOK_ALLOW_UNSIGNED=False

# ============================================================================
# CELERY — limites de tempo (opcional; defaults no settings.py)
# ============================================================================
# Soft limit dispara SoftTimeLimitExceeded (podemos capturar).
# Hard limit mata o worker à força. Precisa ser > soft.
# Regra: soft > (timeout_adapter + auth + mapper) com folga.

# CELERY_TASK_TIME_LIMIT=300
# CELERY_TASK_SOFT_TIME_LIMIT=240
# CELERY_RESULT_EXPIRES=259200

# ============================================================================
# LOGS
# ============================================================================

LOG_LEVEL=INFO

# Loga todas as queries SQL no console (útil para depurar mappers). Deixe False
# em uso normal — polui muito.
LOG_SQL=False

# ============================================================================
# SENTRY (OPCIONAL)
# ============================================================================
# Deixe SENTRY_DSN vazio para desabilitar completamente.
# Se preencher, o settings.py importa e inicializa o SDK automaticamente.

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1